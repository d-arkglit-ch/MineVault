# ==============================================================================
# CMPDI Geological Intelligence & Exploration Records Portal (SIH26023)
# Backend Environment Configuration Template (.env.example)
# ==============================================================================

# AI & Multi-Agent Keys (Google Gemini API: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
# Google Cloud Vision API Key (GCP Console -> APIs & Services -> Credentials)
GOOGLE_VISION_API_KEY=
OPENAI_API_KEY=

# Application
PROJECT_NAME="GeoMine AI Backend (SIH26023)"
API_V1_STR="/api/v1"
DEBUG=True

# CORS
FRONTEND_ORIGIN="http://localhost:3000"
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# Database & Storage
DATABASE_URL="sqlite:///./geomine.db"
CHROMA_PERSIST_DIRECTORY="./chroma_db"
STORAGE_DIR="./uploads"
